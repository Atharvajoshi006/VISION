# ------------------------------------------------------------------------------
# VISION BACKEND (Django) - Environment Variables TEMPLATE
# ------------------------------------------------------------------------------

# Django Core
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - Supabase PostgreSQL (Transaction Pooler recommended)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Google OAuth (Secure Backend Validation)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Configuration - Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Background Tasks - Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Security & Authentication
JWT_SECRET_KEY=your_jwt_private_secret_here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage & Logging
LOG_LEVEL=INFO
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/
