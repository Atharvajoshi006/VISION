# ==============================================================================
# VISION — AI-Driven Adaptive Learning Intelligence Platform
# Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core
# ------------------------------------------------------------------------------
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-django-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# PostgreSQL Database (Supabase)
# Grab the Transaction connection string from your Supabase Dashboard
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-region.pooler.supabase.com:6543/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://vision_user:your_postgres_password_here@localhost:5432/vision_db

# ------------------------------------------------------------------------------
# Redis (Cache + Celery Broker)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ------------------------------------------------------------------------------
# *** GEMINI API KEY — PASTE YOUR KEY HERE ***
# Get your key from: https://aistudio.google.com/app/apikey
# Used ONLY for: explanation generation, quiz generation, hints, summaries
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# Email (for password reset, notifications)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=noreply@vision-ai.com

# ------------------------------------------------------------------------------
# ML Model Storage
# Path where trained scikit-learn / XGBoost models are saved
# ------------------------------------------------------------------------------
ML_MODELS_DIR=ml_models/

# ------------------------------------------------------------------------------
# CORS (Frontend URL)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# File Storage
# ------------------------------------------------------------------------------
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# ------------------------------------------------------------------------------
# Monitoring / Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
ENABLE_ML_PREDICTIONS=True
ENABLE_GEMINI_AI=True
ENABLE_ADAPTIVE_INTERVENTIONS=True
